PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/retzon
# true on hosts that require SSL (Render, Railway, Neon, Supabase...)
DATABASE_SSL=false
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5000
# First admin, created on first start only if no admin exists (password 10+ chars)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=use-a-long-password-here
